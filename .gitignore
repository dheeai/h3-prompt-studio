node_modules/
dist/
.DS_Store

# Local-only overrides (e.g. VITE_LOCAL_LORA_STACK) — Vite inlines VITE_* at
# BUILD time from these, and the GitHub Pages build runs from a fresh
# checkout with none present, so anything here never reaches the public
# site. Never commit one of these files.
.env.local
.env.*.local
# Any hand-made copy of a local env file too — `.env.local.bak-20260917` got
# swept into a commit by a `git add -A`, and it carries the real tailnet
# hostname and the operator's own LoRA stack into a PUBLIC repo. The narrow
# patterns above did not cover it; this one covers every variant.
.env.local*
.env*.bak*
# public/skills/ is deliberately NOT ignored: whatever is in it gets served to
# every visitor, so it should always be visible in `git status` before a push.

# Seeded design-canvas payloads — generated from the .dc.html sources beside
# them (~2.5 MB of editor code each). Re-seed rather than version them. The
# sources (.dc.html + canvas.json) ARE tracked; only the built canvas is not.
design/**/*-redesign.html

# GEPA's authored-prompt cache — content-addressed, regenerable, and would
# otherwise dump one JSON file per (instruction, story) pair into the repo.
# probe/gepa/runs/ is deliberately NOT ignored: every prompt GEPA produces is
# kept (founder directive).
probe/gepa/.cache/
