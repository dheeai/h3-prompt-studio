{
  "name": "h3-prompt-studio",
  "version": "0.1.0",
  "description": "A browser-only prompt refinery: load craft skills, paste a story, refine it against a local or remote model.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "h3-prompt-studio": "./bin/serve.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node bin/serve.mjs",
    "bake-skills": "node scripts/bake-skills.mjs",
    "test": "node --import tsx --test $(find src -name '*.test.ts' | sort)"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@opentelemetry/api": "^1.9.1",
    "fflate": "^0.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
