{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Qwen Image 2.1 model"
    }
  },
  "cache": {
    "class_type": "QwenImage21Cache",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "device": "auto",
      "dtype": "default"
    },
    "_meta": {
      "title": "Qwen Image 2.1 Cache"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
      "type": "qwen_image",
      "device": "default"
    },
    "_meta": {
      "title": "Qwen3-VL (qwen_image, vision)"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
    },
    "_meta": {
      "title": "Qwen Image 2.1 VAE"
    }
  },
  "load_base": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "qwen21_edit_base.png"
    },
    "_meta": {
      "title": "Base plate (image_1 -- the edit target; output follows its size)"
    }
  },
  "encode": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "prompt": "",
      "negative_prompt": "",
      "resolution": 0,
      "images.image_1": [
        "load_base",
        0
      ]
    },
    "_meta": {
      "title": "Text Encode Qwen Image 2.1 (resolution 0 = keep image_1's own size, rounded to a multiple of 32)"
    }
  },
  "ksampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "cache",
        0
      ],
      "positive": [
        "encode",
        0
      ],
      "negative": [
        "encode",
        1
      ],
      "latent_image": [
        "encode",
        2
      ],
      "seed": 42,
      "steps": 25,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    },
    "_meta": {
      "title": "KSampler (Qwen Image 2.1 official: 25 steps, cfg 1.0, euler/simple)"
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "ksampler",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    },
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "qwen21_edit"
    },
    "_meta": {
      "title": "Save"
    }
  }
}
